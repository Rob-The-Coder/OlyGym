<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The rest timer's lock-screen notification. shortService carries no type-specific
         permission of its own, so FOREGROUND_SERVICE is the whole requirement here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- The demo poster frames, hotlinked from img.youtube.com: the only network this app does,
         exactly as the web app does it. Nothing of the training log ever leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OlyGymApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OlyGym">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The rest timer's notification buttons. Explicit intents only (the PendingIntents name
             this class), so nothing else can reach it and no intent-filter is needed. -->
        <receiver
            android:name=".rest.RestActionReceiver"
            android:exported="false" />

        <!-- Keeps the Live Update card's progress bar filling on Android 16+ (RestTimerService).
             A shortService because a rest is a bounded, user-started timer, and that type caps it
             at a few minutes. It is only ever started on API 36+. -->
        <service
            android:name=".rest.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
