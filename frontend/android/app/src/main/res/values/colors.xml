<?xml version="1.0" encoding="utf-8"?>
<!-- The widget is native, so it cannot read the app's CSS custom properties. These three are a
     copy of three roles in frontend/src/m3.tokens.css — surface-container, on-surface and
     on-surface-variant — and that block is itself GENERATED by scripts/design/m3-scheme.mjs, so
     re-copy these values (and values-night) if the palette is ever regenerated.
     lib/contrast.test.js audits the CSS, not this file.

     values/ is the LIGHT palette and values-night/ the dark one: the widget follows the system's
     night mode like every other widget on the home screen, which is not the same thing as the
     app's own theme setting (S.theme). These are the hexes from :root[data-theme="light"].

     No accent colour: the accent is one of eight user-chosen seeds, and painting the widget with
     it would mean shipping a second scheme here and keeping the two in step for a decoration. -->
<resources>
    <color name="widget_surface">#ffffff</color>
    <color name="widget_on_surface">#1d1a21</color>
    <color name="widget_on_surface_variant">#48454d</color>
</resources>
