<?xml version="1.0" encoding="utf-8"?>
<!-- Both of the widget's palettes. Which one applies is decided at draw time from widget.json's
     "theme", which is the THEME THE APP IS IN — not the phone's night mode, and deliberately so:
     OlyGym has its own light/dark setting, and someone running it dark wants the widget dark on a
     light phone. That is why there is no values-night/ here.

     These six are copies of six roles in frontend/src/m3.tokens.css — surface-container, on-surface
     and on-surface-variant, in the plain :root (dark) and :root[data-theme="light"] blocks — and
     that file is GENERATED by scripts/design/m3-scheme.mjs. Re-copy them if the palette is ever
     regenerated; lib/contrast.test.js audits the CSS, not this file.

     No accent: it is one of eight user-chosen seeds, and painting the widget with it would mean
     shipping a second scheme here and keeping the two in step for a decoration. -->
<resources>
    <color name="widget_surface_light">#ffffff</color>
    <color name="widget_on_surface_light">#1d1a21</color>
    <color name="widget_on_surface_variant_light">#48454d</color>

    <color name="widget_surface_dark">#252229</color>
    <color name="widget_on_surface_dark">#e4e1ea</color>
    <color name="widget_on_surface_variant_dark">#c8c5ce</color>
</resources>
