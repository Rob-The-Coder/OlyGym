<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's sample card, and the fill for the instant before the first onUpdate. At runtime the
     provider paints w_bg with a bitmap in the app's own accent, which is why this is one fixed
     colour rather than a set of them. 28dp is the m3 shape-xl the hero uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_container" />
    <corners android:radius="28dp" />
</shape>
