<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's whole layout: Home's hero, showing the one exercise you are on and the three
     controls that act on it.

     A FrameLayout wrapper so the card's fill can be a bitmap the provider paints at the widget's own
     size and in the app's accent (TodayWidgetProvider.makeCard) — no drawable can carry a colour
     that follows eight seeds. The three controls are ImageButtons whose images are likewise drawn
     as bitmaps (fill + glyph), because their fill is the card's own ink at 14%.

     RemoteViews supports a fixed handful of views: FrameLayout, LinearLayout, TextView, ImageView,
     ImageButton. NOT a plain View — a spacer here once made the host answer "Can't load widget";
     the status line is held down by layout_weight instead.

     The android:text defaults are the launcher's sample: what the picker draws (this layout is the
     previewLayout on API 31+) and what shows for the instant before the first onUpdate. The provider
     overwrites every one of them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/w_over"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_preview_over"
            android:textAllCaps="true"
            android:textColor="@color/widget_preview_on"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/w_mark"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_preview_circle"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/w_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_w_dumbbell" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:text="@string/widget_preview_title"
                    android:textColor="@color/widget_preview_on"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.78"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_preview_sub"
                    android:textColor="@color/widget_preview_on"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The one exercise you are on, and the set in front of you. -->
        <TextView
            android:id="@+id/w_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_preview_now"
            android:textColor="@color/widget_preview_on"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_scheme"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_preview_scheme"
            android:textColor="@color/widget_preview_on"
            android:textSize="12.5sp" />

        <LinearLayout
            android:id="@+id/w_acts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/widget_prev"
                android:scaleType="fitXY" />

            <ImageButton
                android:id="@+id/w_check"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="@string/widget_check"
                android:scaleType="fitXY" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/widget_next"
                android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
