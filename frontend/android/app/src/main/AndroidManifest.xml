<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The rest timer's notification buttons. Explicit intents only (the PendingIntents name
             this class), so nothing else can reach it and no intent-filter is needed. -->
        <receiver
            android:name=".RestActionReceiver"
            android:exported="false" />

        <!-- Keeps the Live Update card's progress bar filling on Android 16+ (RestTimerService).
             A shortService because a rest is a bounded, user-started timer, and that type caps it
             at a few minutes. It is only ever started on API 36+. -->
        <service
            android:name=".RestTimerService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rest timer on the lock screen. The local-notifications plugin merges this too; declared
         here so the app's own requirement is legible. Runtime request reuses that plugin's flow. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The lock-screen timer's ticker (Android 16+, RestTimerService). shortService needs no
         type-specific permission of its own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Workout-day reminder: lets the local-notifications plugin fire at the exact minute
         on Android 12+. Where it isn't granted, scheduling silently falls back to inexact
         alarms — the reminder still arrives, just not to the minute. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
