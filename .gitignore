# Nothing downloads exercise media any more (the pictures are YouTube poster frames),
# but an instance that ran an older version still has the folder sitting there.
media/

# Runtime data — users, passkeys, per-user state, session secret. Anchored to the repository root:
# unanchored, this also hides any nested directory called data, source packages included.
/data/

# Local config
.env

# Personal training plan (the coach's workbook — personal data, never published)
*.xlsx

# IDE project files
.idea/

# Working notes and throwaway previews: kept in the workspace on purpose, not in the repo.
# Every mockup, screenshot and comparison from the UI work lives in oly-previews/.
OLYGYM_PLAN.md
oly-previews/

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/

# graphify's local knowledge graph and its ignore file (regenerated on every run, never published)
graphify-out/
.graphifyignore

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local Android release signing key + the APKs built with it (docs/MOBILE.md)
android-keys/
*.jks
*.keystore
*.apk
*.idsig
